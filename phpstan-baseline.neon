parameters:
	ignoreErrors:
		-
			message: '#^Generator expects value type array\{bool\}, array\{mixed\} given\.$#'
			identifier: generator.valueType
			count: 3
			path: src/BoolProvider.php

		-
			message: '#^Generator expects value type array\{float\}, array\{mixed\} given\.$#'
			identifier: generator.valueType
			count: 7
			path: src/FloatProvider.php

		-
			message: '#^Generator expects value type array\{int\}, array\{mixed\} given\.$#'
			identifier: generator.valueType
			count: 7
			path: src/IntProvider.php

		-
			message: '#^Generator expects value type array\{null\}, array\{mixed\} given\.$#'
			identifier: generator.valueType
			count: 1
			path: src/NullProvider.php

		-
			message: '#^Generator expects value type array\{bool\}, array\{mixed\} given\.$#'
			identifier: generator.valueType
			count: 1
			path: src/ObjectProvider.php

		-
			message: '#^Generator expects value type array\{resource\}, array\{mixed\} given\.$#'
			identifier: generator.valueType
			count: 1
			path: src/ResourceProvider.php

		-
			message: '#^Generator expects value type array\{string\}, array\{mixed\} given\.$#'
			identifier: generator.valueType
			count: 6
			path: src/StringProvider.php

		-
			message: '#^Method Ergebnis\\DataProvider\\StringProvider\:\:values\(\) should return array\<string, string\> but returns array\<mixed, mixed\>\.$#'
			identifier: return.type
			count: 1
			path: src/StringProvider.php

		-
			message: '#^Parameter \#2 \.\.\.\$args of function array_merge expects array, array\<string, string\>\|false given\.$#'
			identifier: argument.type
			count: 1
			path: src/StringProvider.php

		-
			message: '#^Parameter \#4 \.\.\.\$args of function array_merge expects array, array\<string, string\>\|false given\.$#'
			identifier: argument.type
			count: 1
			path: src/StringProvider.php

		-
			message: '#^Parameter \#5 \.\.\.\$args of function array_merge expects array, array\<string, string\>\|false given\.$#'
			identifier: argument.type
			count: 1
			path: src/StringProvider.php

		-
			message: '#^Generator expects value type array\{string\}, array\{mixed\} given\.$#'
			identifier: generator.valueType
			count: 3
			path: src/UuidProvider.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertIsArray\(\) with array\<mixed\> and non\-falsy\-string will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: test/Unit/AbstractProviderTestCase.php

		-
			message: '#^Method Ergebnis\\DataProvider\\Test\\Unit\\AbstractProviderTestCase\:\:assertDataSetsAreNotEmpty\(\) has parameter \$actual with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: test/Unit/AbstractProviderTestCase.php

		-
			message: '#^Method Ergebnis\\DataProvider\\Test\\Unit\\AbstractProviderTestCase\:\:assertExpectedValuesAreNotEmpty\(\) has parameter \$values with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: test/Unit/AbstractProviderTestCase.php

		-
			message: '#^Loose comparison via "\=\=" is not allowed\.$#'
			identifier: equal.notAllowed
			count: 1
			path: test/Util/Specification/Equal.php


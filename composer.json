{
  "name": "ergebnis/data-provider",
  "description": "Provides generic data providers for use with phpunit/phpunit.",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "phpunit",
    "data-provider"
  ],
  "authors": [
    {
      "name": "Andreas Möller",
      "email": "am@localheinz.com",
      "homepage": "https://localheinz.com"
    }
  ],
  "homepage": "https://github.com/ergebnis/data-provider",
  "support": {
    "issues": "https://github.com/ergebnis/data-provider/issues",
    "source": "https://github.com/ergebnis/data-provider"
  },
  "require": {
    "php": "~7.4.0 || ~8.0.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
    "fakerphp/faker": "^1.21.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.53.0",
    "ergebnis/license": "^2.7.0",
    "ergebnis/php-cs-fixer-config": "^6.63.2",
    "ergebnis/phpunit-slow-test-detector": "^2.25.0",
    "ergebnis/rector-rules": "^1.18.4",
    "infection/infection": "~0.26.6",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.2.15",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "phpstan/phpstan-phpunit": "^2.0.18",
    "phpstan/phpstan-strict-rules": "^2.0.12",
    "phpunit/phpunit": "^9.6.33",
    "rector/rector": "^2.6.7"
  },
  "autoload": {
    "psr-4": {
      "Ergebnis\\DataProvider\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ergebnis\\DataProvider\\Test\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "audit": {
      "abandoned": "report"
    },
    "platform": {
      "php": "7.4.33"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "3.4-dev"
    },
    "composer-normalize": {
      "indent-size": 2,
      "indent-style": "space"
    }
  }
}
